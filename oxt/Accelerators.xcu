<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Accelerators" oor:package="org.openoffice.Office">
  <node oor:name="PrimaryKeys">
    <node oor:name="Modules">

      <!--
        Un seul raccourci : ouvrir la palette universelle.
        ⚠ JAMAIS Ctrl+Shift+Espace (SPACE_SHIFT_MOD1) : c'est l'espace
        insécable dans Writer et « Tout sélectionner » dans Calc.
        SPACE_MOD1_MOD2 = Ctrl+Alt+Espace (Win/Linux) — slot libre vérifié.
        SPACE_MOD3_MOD2 = Ctrl+Opt+Espace (macOS, où MOD1=Cmd est capté par
        le Finder) — MOD3 n'existe pas ailleurs, binding inerte hors macOS.
      -->

      <node oor:name="com.sun.star.text.TextDocument">
        <node oor:name="SPACE_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">service:fr.gouv.interieur.mirai.do?OpenAssistant&amp;src=key</value>
          </prop>
        </node>
        <node oor:name="SPACE_MOD3_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">service:fr.gouv.interieur.mirai.do?OpenAssistant&amp;src=key</value>
          </prop>
        </node>
      </node>

      <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
        <node oor:name="SPACE_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">service:fr.gouv.interieur.mirai.do?OpenAssistant&amp;src=key</value>
          </prop>
        </node>
        <node oor:name="SPACE_MOD3_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">service:fr.gouv.interieur.mirai.do?OpenAssistant&amp;src=key</value>
          </prop>
        </node>
      </node>

    </node>
  </node>
</oor:component-data>
